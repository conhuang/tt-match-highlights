FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04

# Install Python 3.11, FFmpeg, and system dependencies
RUN apt-get update && apt-get install -y \
    python3.11 python3.11-venv python3.11-dev python3-pip \
    ffmpeg libsm6 libxext6 libgl1-mesa-glx curl git \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default python3
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

WORKDIR /app

# Copy requirements and install dependencies
COPY app/requirements.txt ./app_requirements.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir -r app_requirements.txt && \
    python3 -m pip install --no-cache-dir boto3 pytest httpx

# Copy codebase
COPY app/ ./app
COPY src/ ./src
COPY pyproject.toml ./
RUN python3 -m pip install --no-deps -e .

COPY scripts/run_gpu_render_job.py ./scripts/

ENTRYPOINT ["python3", "scripts/run_gpu_render_job.py"]
